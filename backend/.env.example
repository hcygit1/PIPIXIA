# Langfuse observability
# Create a project at https://cloud.langfuse.com, then copy keys from
# Project settings -> API keys into backend/.env (never commit backend/.env).
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME
LANGFUSE_HOST=https://cloud.langfuse.com

# Model provider credentials referenced by backend/data/config.json
PIPIXIA_BAILIAN_API_KEY=sk-REPLACE_ME

# Shared LLM settings used by the main Agent, memory processing and offline evaluation
OPENAI_API_KEY=sk-REPLACE_ME
PIPIXIA_LLM_BASE_URL=https://st8tp3ajl0df3n8b8l8qu.apigateway-cn-beijing.volceapi.com/v1
PIPIXIA_LLM_MODEL=deepseek-v4-flash

# Embedding credential used by the memory pipeline
PIPIXIA_EMBEDDING_API_KEY=${PIPIXIA_BAILIAN_API_KEY}
