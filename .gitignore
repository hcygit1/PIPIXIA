# ============================================================
# PIPIXIA .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.eggs/
*.so
.venv/
backend/.venv/
venv/
env/
.env
**/__pycache__/
*.pyo
evals
# Backend runtime data (all generated by `python cli.py setup`)
# Note: .gitkeep files are kept to ensure directory structure is tracked
backend/data/agents/
!backend/data/agents/.gitkeep
backend/data/subagents/
!backend/data/subagents/.gitkeep
backend/data/cron/
!backend/data/cron/.gitkeep
backend/data/config.json
backend/data/**/logs/
backend/data/**/*.jsonl
backend/data/**/*.db
backend/data/**/*.db-wal
backend/data/**/*.db-shm
backend/data/**/skills-store/
# SkillLearnBench dataset manifest is generated per machine (absolute benchmark_root)
backend/data/evaluation/skilllearnbench/manifest.json

# Project analysis docs (local development only)
docs-analysis/
docs/
/skills/
.planning/
项目学习.md
项目改进.md
问题跟踪.md
TOOL_RESULT_PERSISTENCE_IMPLEMENTATION.md

# Env files with secrets
backend/.env
!backend/.env.example

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/test-results/
frontend/playwright-report/

# IDE
.cursor/
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test/cache
.pytest_cache/
backend/.pytest_cache/
**/.pytest_cache/
.ruff_cache/
.mypy_cache/
